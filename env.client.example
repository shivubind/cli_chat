# ═══════════════════════════════════════════════════════════════════════════════
# VChat Client Environment Configuration
# Copy to .env and update with your server details
# ═══════════════════════════════════════════════════════════════════════════════

# LiveKit Server Connection
# Change to your remote server address (e.g., ws://192.168.1.100:7880)
LIVEKIT_URL=ws://localhost:7880

# LiveKit Authentication (must match server config)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Room name (must match what agent joins)
# LIVEKIT_ROOM=vchat-room

# Your identity (optional, default: user)
# USER_IDENTITY=user

