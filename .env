# LiveKit Server Configuration
# ============================================================
# Copy this file to .env:  cp env.example .env
#
# For local development, install LiveKit server:
#   curl -sSL https://get.livekit.io | bash
#   livekit-server --dev
#
# For cloud deployment, use LiveKit Cloud: https://cloud.livekit.io

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# For LiveKit Cloud, use:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret

# ============================================================
# AI Model Configuration
# ============================================================

# Whisper STT Model (tiny, base, small, medium, large)
WHISPER_MODEL=small

# Ollama LLM
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://localhost:11434

# Kokoro TTS Voice
KOKORO_VOICE=af_heart

